<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WarcArchiver.App</RootNamespace>
    <AssemblyName>WarcArchiver</AssemblyName>

    <!-- Crisp rendering on every monitor, and the default font used by ApplicationConfiguration.Initialize(). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>

    <!-- Keep the footprint small: no ICU, workstation non-concurrent GC, no tiered PGO instrumentation. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationIcon>icowarc.ico</ApplicationIcon>
    <Authors>ICAZA</Authors>
    <Company>ICAZA MEDIA</Company>
    <Copyright>MIT</Copyright>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icowarc.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WarcArchiver.Core\WarcArchiver.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The user-editable configuration file is copied next to the executable (an existing, newer copy is kept). -->
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Ask the GC to compact more aggressively when the app is idle. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

</Project>
